# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# Virtual environment
.venv/

# Models (large binary files — track with DVC instead)
models/weights/models/
models/weights/*.zip
models/weights/*.pt
models/weights/*.pth
models/weights/*.onnx
models/weights/*.bin
models/tensorrt/*.engine
models/tensorrt/*.trt
models/custom/*.pt
models/custom/*.pth
!models/weights/.gitkeep
!models/tensorrt/.gitkeep
!models/custom/.gitkeep

# Model-signing manifest (scripts/sign_models.py) — generated at bootstrap from
# whatever weights are present locally; holds machine-specific absolute paths
# and sign timestamps, so it's per-clone, not source.
models/manifest.json

# Auto-downloaded weights that land at repo root (e.g. `YOLO('yolo26m.pt')`
# downloads to cwd) and weight caches outside models/ (e.g. CLIP for YOLO-World)
/*.pt
/*.pth
/*.onnx
/weights/

# Captured/auto-labeled training datasets (scripts/capture_dataset.py) — large
# binary image data, not source; track with DVC if needed, not git
/datasets/

# Data (track with DVC)
data/raw/
data/processed/
data/enrolled/
data/feedback/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Live camera snapshots written by run_live.py/run_objects.py for the
# dashboard's /stream endpoint — ephemeral, regenerated every frame
data/snapshots/
!data/enrolled/.gitkeep
!data/feedback/.gitkeep

# Logs
logs/
*.log

# Archives (video segments)
/tmp/third-eye-archive/

# IDE / AI tooling — local-only, was previously relying on a per-clone-only
# .git/info/exclude entry that doesn't travel with the repo
.idea/
.vscode/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.xml

# DVC
.dvc/tmp/
.dvc/cache/

# MLflow
mlruns/
mlflow.db

# Frontend (frontend/settings and any future React/Vite app) — each has its
# own .gitignore too, but node_modules is exactly the class of huge
# generated directory this file exists to keep out, so cover it here too.
# dist/ above already catches each app's build output.
node_modules/

# Docker
*.pid

# self-signed TLS certs (generated by scripts/gen_certs.sh) + any stray
# private-key / keystore material anywhere in the tree — never commit keys
# in a security project. (No .key/.pem are tracked today; this is a guard.)
infrastructure/certs/
*.key
*.pem
*.p12
*.pfx
