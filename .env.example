# Template for .env. Don't fill secrets by hand — run `make setup`
# (or `python3 scripts/setup_env.py`) to generate strong random values for
# every `change-me-*` placeholder. It's idempotent and only adds missing keys.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development               # development | production
APP_SECRET_KEY=change-me-in-production-min-32-chars
APP_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-min-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=thirdeye
POSTGRES_USER=thirdeye
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://thirdeye:change-me-strong-password@postgres:5432/thirdeye

# ── TimescaleDB (same PG instance, separate DB) ───────────────────────────────
TIMESCALE_DB=thirdeye_ts
TIMESCALE_URL=postgresql+asyncpg://thirdeye:change-me-strong-password@postgres:5432/thirdeye_ts

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-redis-password

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=third-eye-main

# ── Object storage (MinIO / S3-compatible) ────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=thirdeye
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=thirdeye-evidence
S3_REGION=us-east-1

# ── ML Models ─────────────────────────────────────────────────────────────────
MODELS_DIR=/app/models
USE_TENSORRT=false                # Set true after running generate_trt_engines.sh
DEVICE=cuda:0

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_LLM_MODEL=mistral:7b-instruct-v0.3-q4_K_M
OLLAMA_VLM_MODEL=llava:7b-v1.5-q4_K_M

# ── Camera defaults ───────────────────────────────────────────────────────────
CAMERA_RECONNECT_INTERVAL_MAX=60   # seconds
CAMERA_FRAME_BUFFER_SIZE=32        # frames per camera

# ── Face recognition thresholds ───────────────────────────────────────────────
FACE_MATCH_ACCEPT_THRESHOLD=0.45
FACE_MATCH_REJECT_THRESHOLD=0.35
FACE_QUALITY_MIN=0.5
ENROLLMENT_MIN_CROPS=10
ENROLLMENT_WINDOW_SECONDS=30

# ── Anti-spoofing ────────────────────────────────────────────────────────────
ANTISPOOFING_CONFIDENCE_MIN=0.85  # below this = default-deny
ANTISPOOFING_TEMPORAL_FRAMES=10

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# ── Data retention ────────────────────────────────────────────────────────────
EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
VIDEO_ARCHIVE_RETENTION_DAYS=30

# ── Encryption ────────────────────────────────────────────────────────────────
EMBEDDING_ENCRYPTION_KEY=change-me-32-byte-fernet-key-base64
